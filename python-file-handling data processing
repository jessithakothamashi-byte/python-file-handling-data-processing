1. Write and Read a Text File
# Write data to a file
with open("students.txt", "w") as file:
    file.write("Rahul - 85\n")
    file.write("Priya - 92\n")
    file.write("Amit - 78\n")

# Read data from the file
with open("students.txt", "r") as file:
    data = file.read()

print(data)

Output:
Rahul - 85
Priya - 92
Amit - 78

2. Count Words in a File
with open("sample.txt", "w") as file:
    file.write("Python is easy to learn\n")
    file.write("Python is powerful")

with open("sample.txt", "r") as file:
    text = file.read()

words = text.split()

print("Total words:", len(words))

Output:
Total words: 8

3. CSV File Processing
import csv

data = [
    ["Name", "Age", "Marks"],
    ["Rahul", 21, 85],
    ["Priya", 20, 92],
    ["Amit", 22, 78]
]

with open("students.csv", "w", newline="") as file:
    writer = csv.writer(file)
    writer.writerows(data)

with open("students.csv", "r") as file:
    reader = csv.reader(file)

    for row in reader:
        print(row)

Output:
['Name', 'Age', 'Marks']
['Rahul', '21', '85']
['Priya', '20', '92']
['Amit', '22', '78']

4. JSON Data Processing
import json

student = {
    "name": "Rahul",
    "age": 21,
    "course": "Python",
    "marks": 85
}

with open("student.json", "w") as file:
    json.dump(student, file, indent=4)

with open("student.json", "r") as file:
    data = json.load(file)

print("Name:", data["name"])
print("Course:", data["course"])
print("Marks:", data["marks"])

Output:
Name: Rahul
Course: Python
Marks: 85

5. Regular Expression for Email Validation
import re

emails = [
    "rahul@gmail.com",
    "priya@yahoo.com",
    "invalid-email"
]

pattern = r'^[\w\.-]+@[\w\.-]+\.\w+$'

for email in emails:
    if re.match(pattern, email):
        print(email, "-> Valid")
    else:
        print(email, "-> Invalid")

Output:
rahul@gmail.com -> Valid
priya@yahoo.com -> Valid
invalid-email -> Invalid
